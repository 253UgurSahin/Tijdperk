{
  "name": "tijdperken",
  "version": "0.2.0",
  "private": true,
  "description": "Real-time strategiespel in de browser: van de steentijd naar het dronetijdperk.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src tests && prettier --check \"src/**/*.{js,css}\" \"tests/**/*.js\"",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.js\" \"*.js\" index.html",
    "build:artifact": "vite build --config vite.artifact.config.js && node scripts/artifact-html.mjs"
  },
  "dependencies": {
    "three": "0.149.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^7.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4"
  }
}
